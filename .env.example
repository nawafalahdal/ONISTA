# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/onista?sslmode=require"

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────
# Generate with: npx auth secret   (min. 32 chars)
AUTH_SECRET=""
# Public canonical URL. Required in production (or AUTH_TRUST_HOST=true
# when deployed behind a trusted proxy such as Vercel).
AUTH_URL="http://localhost:3000"

# ── Security ─────────────────────────────────────────────────────────────
# Salt for hashing client IPs before storage. Generate: openssl rand -hex 32
IP_HASH_SECRET=""
# Distributed rate limiting (required when running more than one instance)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ── Business ─────────────────────────────────────────────────────────────
# WhatsApp number with country code, digits only
BUSINESS_WHATSAPP_NUMBER="9665XXXXXXXX"

# ── Seeding (first admin account; used by `npm run db:seed` only) ────────
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""   # min. 12 chars
