# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/onista?sslmode=require"
# Direct (non-pooled) URL for migrations; Neon sets this automatically.
# DATABASE_URL_UNPOOLED=""

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────
# Generate with: npx auth secret   (min. 32 chars)
AUTH_SECRET=""
# Public canonical URL. Required in production (or AUTH_TRUST_HOST=true
# when deployed behind a trusted proxy such as Vercel).
AUTH_URL="http://localhost:3000"

# ── Security ─────────────────────────────────────────────────────────────
# Salt for hashing client IPs before storage. Generate: openssl rand -hex 32
IP_HASH_SECRET=""
# Distributed rate limiting (required when running more than one instance)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ── Business ─────────────────────────────────────────────────────────────
# WhatsApp number with country code, digits only
BUSINESS_WHATSAPP_NUMBER="9665XXXXXXXX"

# ── Seeding (first admin account; used by `npm run db:seed` only) ────────
# Preview phase: any password up to 128 chars is accepted (strict policy is
# restored before launch). Seeding never fails the deploy.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Recovery only: set to "true" for ONE deploy to reset the existing admin's
# password to SEED_ADMIN_PASSWORD (signs out all sessions), then remove it.
# SEED_ADMIN_RESET_PASSWORD="true"
